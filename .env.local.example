# Saathi Vyapar — local environment
# Copy to .env.local and fill in. Never commit the filled-in file.

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL and keys from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Bypasses Row Level Security — never expose to the browser and
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Language model (optional) ───────────────────────────────────────────
# Without any of this the app still works: every LLM call falls back to
# deterministic output from the financial engine and the local parser.
#
# 1. Hosted Gemini — set the key and nothing else:
GEMINI_API_KEY=
#
# 2. Self-hosted, OpenAI-compatible (Ollama, vLLM, llama.cpp, Hugging Face).
#    Setting LLM_BASE_URL switches the app over automatically, even if a
#    GEMINI_API_KEY is still present — handy for demoing on a laptop.
#
#    Laptop demo with Ollama:
#      ollama pull sarvam-2b        (or gemma3:4b, qwen3:4b)
#      LLM_BASE_URL=http://localhost:11434/v1
#      LLM_MODEL=sarvam-2b
#
#    Khata Mitra (the bookkeeping assistant) drives the model with tool
#    calls, so pick one that supports them: qwen3, llama3.1+, gemma3,
#    mistral — Ollama lists the capability on each model's page.
#
#    Hugging Face Inference:
#      LLM_BASE_URL=https://router.huggingface.co/v1
#      LLM_MODEL=sarvamai/sarvam-2b
#      LLM_API_KEY=hf_...
#
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Force a backend instead of inferring it: gemini | openai-compatible
LLM_PROVIDER=
# A 2B model on laptop CPU is slow; raise this if replies time out.
LLM_TIMEOUT_MS=30000

# NOTE: voice-note transcription is speech-to-text, not text generation, and
# still uses GEMINI_API_KEY. Self-hosting it needs a separate ASR service
# (Whisper / IndicWhisper); LLM_BASE_URL does not cover it. This also means
# Khata Mitra's mic button needs GEMINI_API_KEY on a non-Gemini setup; its
# text input works on any provider.

GROQ_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── WhatsApp Cloud API ──────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App Secret from Meta → App Settings → Basic. REQUIRED IN PRODUCTION:
# inbound webhooks are rejected unless X-Hub-Signature-256 verifies against
# it. Leave blank locally and unsigned webhooks are accepted with a warning.
WHATSAPP_APP_SECRET=

# ── Twilio SMS ──────────────────────────────────────────────────────────
# TWILIO_AUTH_TOKEN also verifies the X-Twilio-Signature on inbound webhooks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
